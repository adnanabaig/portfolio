{
  "name": "adnan-baig-portfolio",
  "version": "3.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:copy": "node scripts/check-copy.mjs && node scripts/check-ops.mjs && node scripts/check-work.mjs",
    "og": "node scripts/build-og.mjs",
    "grain": "node scripts/build-grain.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "autoprefixer": "^10.4.7",
    "gray-matter": "^4.0.3",
    "next": "12.1.6",
    "postcss": "^8.4.13",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "remark": "^14.0.2",
    "remark-html": "^15.0.1",
    "tailwindcss": "^3.0.24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "8.15.0",
    "eslint-config-next": "12.1.6",
    "typescript": "^5.0.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
